{
  "name": "sellable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sellable — paste the CA, know if you can sell. Token trade-safety + alerts for BOT Chain.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.9.0 <25"
  },
  "overrides": {
    "postcss": "8.5.32",
    "tmp": "0.2.7"
  },
  "scripts": {
    "check": "node --env-file-if-exists=.env --import tsx packages/cli/src/main.ts",
    "smoke": "node --env-file-if-exists=.env --import tsx packages/cli/src/smoke.ts",
    "test": "node --import tsx packages/db/test/all.ts && node --import tsx packages/core/test/all.ts && node --import tsx packages/probe/test/all.ts && node --import tsx packages/api/test/all.ts && node --import tsx packages/bot/test/all.ts",
    "api": "node --env-file-if-exists=.env --import tsx packages/api/src/main.ts",
    "bot": "node --env-file-if-exists=.env --import tsx packages/bot/src/main.ts",
    "web": "npm run dev -w @sellable/web",
    "web:build": "npm run build -w @sellable/web",
    "probe": "node --env-file-if-exists=.env --import tsx packages/probe/src/main.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx packages/db/src/migrate.ts",
    "seed": "node --env-file-if-exists=.env --import tsx packages/db/src/seed.ts",
    "build": "tsc -b tsconfig.build.json",
    "harness:compile": "node --env-file-if-exists=.env --import tsx packages/harness/src/compile.ts",
    "harness:deploy": "node --env-file-if-exists=.env --import tsx packages/harness/src/deploy.ts",
    "contracts:compile": "node --env-file-if-exists=.env --import tsx packages/contracts/src/compile.ts",
    "contracts:deploy": "node --env-file-if-exists=.env --import tsx packages/contracts/src/deploy.ts",
    "mainnet:preflight": "node --env-file-if-exists=.env --import tsx packages/cli/src/preflight.ts",
    "test:integration": "node --env-file-if-exists=.env --import tsx packages/db/test/integration.ts",
    "harness:verify": "node --env-file-if-exists=.env --import tsx packages/harness/src/verify.ts",
    "harness:liquidity": "node --env-file-if-exists=.env --import tsx packages/harness/src/liquidity.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "ethers": "^6.13.0",
    "hono": "^4.13.13",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
