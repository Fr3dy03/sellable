# --- RPC ---
MAINNET_RPC=https://rpc.botchain.ai
TESTNET_RPC=https://rpc.bohr.life
# set to "testnet" to run analyzer/probe/API against Bohr (chainId 968)
CHAIN_ENV=

# --- Harness (Phase 0 testnet deploy only) ---
# Funded Bohr testnet key. Claim tBOT first: dev-docs.botchain.ai/docs/Developers/claim-test-tbot-tokens/
DEPLOYER_PRIVATE_KEY=

# --- Probe worker (Phase 1 mainnet) ---
# Hot wallet holding ~0.5-2 BOT for real buy->sell probes. NEVER a custody wallet.
PROBE_PRIVATE_KEY=
# hard stop: total probe cost (notional + gas) per UTC day
PROBE_DAILY_BUDGET_BOT=1

# --- API / worker storage ---
# set to a postgres connection string to persist; unset = in-memory (dev)
DB_URL=
# JSON file store shared by API + probe worker across processes (local dev without Postgres)
DB_FILE=./data/dev-store.json
PORT=8787

# --- Telegram bot (Phase 3) ---
# create a bot via @BotFather; required to run `npm run bot`
TELEGRAM_BOT_TOKEN=
# chat id that receives new-pair + broadcast probe alerts (optional but recommended)
TELEGRAM_ALERT_CHAT=
# new-pair scanner poll interval in ms
TELEGRAM_SCAN_INTERVAL_MS=20000
